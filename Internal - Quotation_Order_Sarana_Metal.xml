<t t-name="studio_report_document">
    <t t-call="web.external_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
        <t t-set="address">
            <div t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
            <p t-if="doc.partner_id.vat">
                <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
            </p>
        </t>
        <t t-if="doc.partner_shipping_id == doc.partner_invoice_id                              and doc.partner_invoice_id != doc.partner_id                              or doc.partner_shipping_id != doc.partner_invoice_id">
            <t t-set="information_block">
                <strong>
                    <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">
                        Invoicing and Shipping Address
                    </t>
                    <t t-else="">
                        Invoicing Address
                    </t>
                </strong>
                <div t-field="doc.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                    <strong class="d-block mt-3">Shipping Address</strong>
                    <div t-field="doc.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                </t>
            </t>
        </t>
        <div class="page">
            <div class="oe_structure"/>

            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
            <t t-set="layout_document_title">
                <span t-if="is_proforma">Pro-Forma Invoice # </span>
                <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
                <!--<span t-else="">Order # </span>-->
                <span t-field="doc.name">SO0000</span>
            </t>

            <div class="row mb-4" id="informations">
                <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                    <strong>Your Reference</strong>
                    <div t-field="doc.client_order_ref">SO0000</div>
                </div>
                <div t-if="doc.date_order" class="col" name="informations_date">
                    <strong t-if="is_proforma">Issued Date</strong>
                    <strong t-elif="doc.state in ['draft', 'sent']">Quotation Date</strong>
                    <strong t-else="">Order Date</strong>
                    <div t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}">2023-12-31</div>
                </div>
                <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col" name="expiration_date">
                    <strong>Expiration</strong>
                    <div t-field="doc.validity_date">2023-12-31</div>
                </div>
            <div class="col" t-if="doc.incoterm">
                <strong>Incoterm</strong>
                <div t-if="doc.incoterm_location">
                    <span t-field="doc.incoterm.code"/> <br/>
                    <span t-field="doc.incoterm_location"/>
                </div>
                <div t-else="" t-field="doc.incoterm.code"/>
            </div>
                <div t-if="doc.user_id.name" class="col">
                    <strong>Sales</strong>
                    <div t-field="doc.x_studio_salesman">Mitchell Admin</div>
                </div>
            </div>
            <div t-if="doc.invoice_ids" class="col">
                <strong>Invoice Information</strong>
                <ul style="margin: 0; padding-left: 1rem;">
                    <t t-foreach="doc.invoice_ids" t-as="inv">
                        <li>
                            <strong>Number:</strong> <span t-field="inv.name"/> |
                            <strong>Date:</strong> <span t-field="inv.invoice_date"/> |
                            <strong>Due Date:</strong> <span t-field="inv.invoice_date_due"/>
                        </li>
                    </t>
                </ul>
            </div>


            <!-- Is there a discount on at least one line? -->
            <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

            <div class="oe_structure"/>
            <table class="o_has_total_table table o_main_table table-borderless">
                <thead style="display: table-row-group">
                    <tr>
                        <th class="text-start">Supplier</th>
                        <th class="text-start">Description</th>
                        <th class="text-end text-nowrap">Quantity</th>
                        <th class="text-end text-nowrap">Harga Jual Satuan</th>
                        <th class="text-end text-nowrap">Harga Beli Satuan</th>
                        <th t-if="display_discount" class="text-end">Disc.%</th>
                        <th class="text-end">Total Harga Jual</th>
                        <th class="text-end">Total Harga Beli</th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">
            
                    <!-- Variabel penampung total -->
                    <t t-set="total_price_subtotal" t-value="0"/>
                    <t t-set="total_cost_total" t-value="0"/>
                    <t t-set="total_po_taxes" t-value="0"/>
                    <t t-set="total_po_with_taxes" t-value="0"/>
                    
                    
                    <t t-set="inc_total_cost_total" t-value="0"/>
                    <t t-set="x_total_cost_total" t-value="0"/>
                    <t t-set="processed_po_ids" t-value="[]"/>
                    <t t-set="is_tax_included" t-value="False"/>
                    

                    <t t-foreach="lines_to_report" t-as="line">
                    <!-- Akumulasi total -->
                    <t t-if="not line.display_type and not line.is_downpayment and line.product_type != 'combo'">
                        <t t-set="total_price_subtotal" t-value="total_price_subtotal + line.price_subtotal"/>
                        <!--<t t-set="total_cost_total" t-value="total_cost_total + ((line.x_studio_cost_1 or 0) * line.product_qty)"/>-->
                        <t t-set="total_po_taxes" t-value="total_po_taxes + line.cdp_total_po_taxes"/>
                        <t t-set="total_po_with_taxes" t-value="total_cost_total + total_po_taxes"/>
                    </t>
                
                    <tr t-att-class="'fw-bold o_line_section' if (line.display_type == 'line_section' or line.product_type == 'combo') else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                
                        <!-- ======================= -->
                        <!-- CASE 1: ADA BEBERAPA PO LINE -->
                        <!-- ======================= -->
                        <t t-if="not line.display_type and line.product_type != 'combo'">
                            <t t-set="valid_po_lines" t-value="line.cdp_po_line_ids.filtered(lambda l: l.order_id.state == 'purchase')"/>
                        
                            <!-- Jika ada PO Line yang valid -->
                            <t t-if="valid_po_lines">
                                <t t-foreach="valid_po_lines" t-as="po_line">
                                    <t t-set="total_cost_total" t-value="total_cost_total + ((po_line.price_unit or 0) * po_line.product_qty)"/>
                                    
                                    <!--kondisi cek apakah purchase tax include atau tax out-->
                                    <!--https://www.falinwa.com/odoo/helpdesk.ticket/13291-->
                                    <t t-set="is_tax_included" t-value="po_line.taxes_id[:1].price_include_override == 'tax_included'"/>
                                    <t t-if="is_tax_included">
                                        <t t-if="po_line.order_id.id not in processed_po_ids and po_line.order_id.state in ['purchase', 'done']">
                                            <t t-set="x_total_cost_total" t-value="x_total_cost_total + po_line.order_id.amount_untaxed"/>
                                            <t t-set="processed_po_ids" t-value="processed_po_ids + [po_line.order_id.id]"/>
                                        </t>                                        <!--<t t-set="price_tax" t-value="inc_total_cost_total + ((po_line.amount_untaxed))"/>-->
                                    </t>
                                    
                                    
                                    <t t-set="total_po_with_taxes" t-value="total_cost_total + total_po_taxes"/>
                                    <tr>
                                        <td><span t-field="po_line.partner_id"/></td>
                                        <td><span t-field="po_line.product_id.display_name"/></td>
                                        <td class="text-end text-nowrap">
                                            <span t-field="po_line.product_qty"/>
                                            <span t-field="po_line.product_uom"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-field="line.price_unit"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-field="po_line.price_unit"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-esc="line.price_unit * po_line.product_qty" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-esc="po_line.price_unit * po_line.product_qty" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        
                            <!-- Jika TIDAK ADA PO Line yang valid -->
                            <t t-else="">
                                <tr>
                                    <!-- Supplier -->
                                    <td>-Not Purchased-</td>
                        
                                    <!-- Description (ambil dari SO line) -->
                                    <td>
                                        <span t-field="line.name"/>
                                    </td>
                        
                                    <!-- Quantity (ambil dari SO line) -->
                                    <td class="text-end text-nowrap">
                                        <span t-field="line.product_uom_qty"/>
                                        <span t-field="line.product_uom"/>
                                    </td>
                        
                                    <!-- Harga SO -->
                                    <td class="text-end text-nowrap">
                                        <span t-field="line.price_unit"/>
                                    </td>
                        
                                    <!-- Harga PO -->
                                    <td class="text-end text-nowrap">-Not Purchased-</td>
                        
                                    <!-- Total SO -->
                                    <td class="text-end text-nowrap">
                                        <span t-esc="line.price_unit * line.product_uom_qty" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                        
                                    <!-- Total PO -->
                                    <td class="text-end text-nowrap">-Not Purchased-</td>
                                </tr>
                            </t>
                        </t>
                        <!-- ======================= -->
                        <!-- CASE 2: SECTION ATAU NOTE -->
                        <!-- ======================= -->
                        <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                            <td colspan="99"><span t-field="line.name"/></td>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <td colspan="99"><span t-field="line.name"/></td>
                        </t>
                
                    </tr>
                </t>

            
                    <!-- Baris TOTAL -->
                    <tr class="fw-bold">
                        <td class="text-end" colspan="5">TOTAL (TAX EXCL.)</td>
                        <td t-if="display_discount"/>
                        <td class="text-end">
                            <span t-out="total_price_subtotal" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                        </td>
                        <td class="text-end">
                            
                            <!--kondisi cek apakah purchase tax include atau tax out-->
                            <!--https://www.falinwa.com/odoo/helpdesk.ticket/13291-->
                            
                            <t t-if="is_tax_included">
                                <span t-out="x_total_cost_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                            </t>
                            <t t-else="">
                                <span t-out="total_cost_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                            </t>
                        </td>
                    </tr>
                    <tr class="fw-bold">
                        <td class="text-end" colspan="5">TOTAL TAXES</td>
                        <td t-if="display_discount"/>
                        <td class="text-end">
                            <span t-field="doc.amount_tax" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                        </td>
                        <td class="text-end">
                            <span t-out="total_po_taxes" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                        </td>
                    </tr>
                    <tr class="fw-bold">
                        <td class="text-end" colspan="5">TOTAL</td>
                        <td t-if="display_discount"/>
                        <td class="text-end">
                            <span t-out="doc.amount_total" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                        </td>
                        <td class="text-end">
                            <span t-out="total_po_with_taxes" t-options="{'widget':'monetary','display_currency':doc.currency_id}"/>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="clearfix" name="so_total_summary">
                <div id="total" class="row mt-n3" name="total">
                    <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                        <table class="o_total_table table table-borderless">
                            <!-- Tax totals -->
                            <!--<t t-call="sale.document_tax_totals_copy_1_copy_1">-->
                            <!--    <t t-set="tax_totals" t-value="doc.tax_totals"/>-->
                            <!--    <t t-set="currency" t-value="doc.currency_id"/>-->
                            <!--</t>-->
                            <t t-foreach="doc.x_studio_additional_cost_ids" t-as="line">
                                <tr>
                                    <td>
                                        <span t-field="line.x_studio_product_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_studio_vendor_id"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.x_studio_amount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                            <!--<td name="td_section_subtotal" colspan="99">-->
                            <!--        <strong class="mr16">Total Harga Jual</strong><br/>-->
                            <!--        <span t-field="doc.cdp_actual_total_margin" class="text-end" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}">31.05</span>-->
                                    <!--<span t-field="doc.cdp_actual_margin_percent">...%</span>-->
                            <!--</td>-->
                            <!--<td name="td_section_subtotal" colspan="99">-->
                            <!--        <strong class="mr16">Total Harga Beli</strong><br/>-->
                            <!--        <span t-field="doc.cdp_actual_total_margin" class="text-end" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}">31.05</span>-->
                                    <!--<span t-field="doc.cdp_actual_margin_percent">...%</span>-->
                            <!--</td>-->
                            <tr name="td_section_subtotal" colspan="99">
                                <td>
                                    <strong class="mr16">Total Profit</strong>
                                    <span t-field="doc.cdp_actual_total_margin" class="text-end" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}">31.05</span>
                                    <!--<span t-field="doc.cdp_actual_margin_percent">...%</span>-->
                                </td>
                                <td>
                                    <strong class="mr16">Total Percent Profit</strong>
                                    <span t-esc="('%.2f' % ((doc.cdp_actual_margin_percent or 0.0) * 100)) + '%'"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            
            <!--<div class="clearfix">-->
            <!--    <div class="row mt-n3">-->
                    <!-- LEFT: Salesman Information -->
            <!--        <div class="col-6">-->
            <!--            <t t-if="doc.x_studio_salesman">-->
            <!--                <div><strong>Sales:</strong> <span t-field="doc.x_studio_salesman.name"/></div>-->
            <!--                <div><strong>Email:</strong> <span t-field="doc.x_studio_salesman.work_email"/></div>-->
            <!--                <div><strong>Phone No:</strong> <span t-field="doc.x_studio_salesman.work_phone"/></div>-->
            <!--            </t>-->
            <!--        </div>-->
            
                    <!-- RIGHT: Total Summary -->
            <!--        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">-->
            <!--            <table class="o_total_table table table-borderless">-->
            <!--                <t t-call="sale.document_tax_totals_copy_3">-->
            <!--                    <t t-set="tax_totals" t-value="doc.tax_totals"/>-->
            <!--                    <t t-set="currency" t-value="doc.currency_id"/>-->
            <!--                </t>-->
            <!--            </table>-->
            <!--        </div>-->
            <!--    </div>-->
            <!--</div>-->

            <div class="oe_structure"/>

            <div t-if="not doc.signature" class="oe_structure"/>
            <div t-else="" class="mt-4 ml64 mr4" name="signature">
                <div class="offset-8">
                    <strong>Signature</strong>
                </div>
                <div class="offset-8">
                    <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                </div>
                <div class="offset-8 text-center">
                    <span t-field="doc.signed_by">Oscar Morgan</span>
                </div>
            </div>
        <div t-if="not (doc.sale_order_option_ids and doc.state in ['draft', 'sent'])" class="oe_structure">​</div>
        <div t-else="">
            <t t-set="has_option_discount" t-value="any(option.discount != 0.0 for option in doc.sale_order_option_ids)"/>
            <h4 name="h_optional_products">
                <span>Options</span>
            </h4>
            <table name="table_optional_products" class="table table-sm">
                <thead class="fw-bold">
                    <tr>
                        <td name="th_option_name" class="text-start">Description</td>
                        <td t-if="has_option_discount" name="th_option_discount" class="text-start">Disc.%</td>
                        <td name="th_option_price_unit" class="text-end">Harga Jual Satuan</td>
                    </tr>
                </thead>
                <tbody class="sale_tbody">
                    <tr t-foreach="doc.sale_order_option_ids" t-as="option">
                        <td name="td_option_name">
                            <span t-field="option.name">Extra Chips</span>
                        </td>
                        <td t-if="has_option_discount" name="td_option_discount">
                            <strong t-if="option.discount != 0.0" class="text-info">
                                <t t-out="((option.discount % 1) and '%s' or '%d') % option.discount">-</t>%
                            </strong>
                        </td>
                        <td name="td_option_price_unit">
                            <strong class="text-end">
                                <div t-field="option.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}" t-att-style="option.discount and 'text-decoration: line-through' or None" t-att-class="option.discount and 'text-danger' or None">1.5</div>
                                <div t-if="option.discount">
                                    <t t-out="((1-option.discount / 100.0) * option.price_unit)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"> </t>
                                </div>
                            </strong>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="oe_structure"/>
        </div>
            <div>
            <p t-if="doc.carrier_id.carrier_description" id="carrier_description">
                <strong>Shipping Description</strong>
                <div t-out="doc.carrier_id.carrier_description"/>
            </p>
                <span t-field="doc.note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note"/>
                <p t-if="not is_html_empty(doc.payment_term_id.note)">
                    <span t-field="doc.payment_term_id.note">The payment should also be transmitted with love</span>
                </p>
                <div class="oe_structure"/>
                <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)" id="fiscal_position_remark">
                    <strong>Fiscal Position Remark:</strong>
                    <span t-field="doc.fiscal_position_id.sudo().note">No further requirements for this payment</span>
                </p>
                <div t-if="not doc.x_studio_signed_people" class="oe_structure"/>
                <div t-else="" class="mt32 ml64 mr4" name="signature">
                    <div class="offset-9">
                        <strong>Your Faithfully</strong>
                    </div>
                    <div class="offset-8">
                        <img t-att-src="image_data_uri(doc.x_studio_sign_template)" style="max-height: 4cm; max-width: 8cm;"/>
                    </div>
                    <div t-if="doc.x_studio_signed_people.name" class="offset-8 text-center">
                        <p t-field="doc.x_studio_signed_people.name">....</p>
                    </div>
                </div>
            </div>
            <div class="oe_structure"/>
        </div>
    </t>
</t>
